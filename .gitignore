# Ignore everything by default
/*

# Allow listed files/directories
!.gitignore
!LICENSE
!README.md
!build_exe.py
!main.py
!requirements.txt
!requirements-bf16.txt
!setup_local_runtime.py
!/tests/
!/tests/**
!/docs/
!/docs/**
!/src/
!/src/**
!/resources/
!/resources/**

# Still ignore build artefacts within allowed directories
__pycache__/
*.pyc
